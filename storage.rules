rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read for public assets
      allow read: if true;
      // Allow writes with strict 10 MB file size limit (10 * 1024 * 1024 = 10485760 bytes)
      allow write: if request.resource.size <= 10 * 1024 * 1024;
    }
  }
}
